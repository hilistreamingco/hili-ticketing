# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# Payment mode: use mock locally until a Daraja Till is available; use daraja in production
MPESA_MODE=mock
# Daraja credentials and till configuration (keep secrets server-side)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_TILL_NUMBER=
MPESA_CALLBACK_URL=

# Supabase public browser configuration
# Supabase-standard names
NEXT_PUBLIC_SUPABASE_URL=https://etyzushxyzlqflfjxkul.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_a1q38OO9StaS_n05_bENhw_Hx1SOwrZ

# Vite aliases used by this React app
VITE_SUPABASE_URL=https://etyzushxyzlqflfjxkul.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_a1q38OO9StaS_n05_bENhw_Hx1SOwrZ

# Server-only Supabase credential; never expose as VITE_ or NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Ticket and contact email delivery (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=hilistreaming.co@gmail.com
