{
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm build:client",
  "outputDirectory": "dist/spa",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/ping", "destination": "/api/ping" },
    { "source": "/api/admin/me", "destination": "/api/admin/me" },
    { "source": "/api/admin/upload-poster", "destination": "/api/admin/upload-poster" },
    { "source": "/api/admin/events/:id/tickets", "destination": "/api/admin/events/[id]/tickets" },
    { "source": "/api/admin/events/:id", "destination": "/api/admin/events/[id]" },
    { "source": "/api/admin/events", "destination": "/api/admin/events" },
    { "source": "/api/admin/tickets/:id", "destination": "/api/admin/tickets/[id]" },
    { "source": "/api/admin/tickets", "destination": "/api/admin/tickets" },
    { "source": "/api/payment-config/:eventSlug", "destination": "/api/payment-config/[eventSlug]" },
    { "source": "/api/orders/manual", "destination": "/api/orders/manual" },
    { "source": "/api/prestige/stats", "destination": "/api/prestige/stats" },
    { "source": "/api/prestige/orders/confirm", "destination": "/api/prestige/orders/confirm" },
    { "source": "/api/prestige/orders/send-ticket", "destination": "/api/prestige/orders/send-ticket" },
    { "source": "/api/prestige/orders/not-found", "destination": "/api/prestige/orders/not-found" },
    { "source": "/api/prestige/orders/:orderId", "destination": "/api/prestige/orders/[orderId]" },
    { "source": "/api/prestige/orders", "destination": "/api/prestige/orders" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
